# ============ TELEGRAM BOT ============
# 1) @BotFather da /newbot orqali bot yarating va tokenni shu yerga qo‘ying
TELEGRAM_BOT_TOKEN=

# 2) Arizalar tushadigan Telegram guruh ID si (odatda -100 bilan boshlanadi)
#    Botni guruhga qo‘shing va guruhda /id yozing — bot ID ni o‘zi aytadi
TELEGRAM_GROUP_ID=

# 3) Admin(lar) Telegram ID si. Bir nechta bo‘lsa vergul bilan: 111111,222222
#    Botga lichkada /id yozing — "Sizning ID" ni shu yerga qo‘ying
TELEGRAM_ADMIN_ID=

# ============ SERVER ============
PORT=3000
# Bot komandalarini (/stats, /export ...) tinglash
BOT_POLLING=true

# Frontend boshqa domenda bo‘lsa, uning manzili (vergul bilan bir nechta):
# CORS_ORIGIN=https://dermolife.uz,https://www.dermolife.uz
CORS_ORIGIN=

# Frontend build papkasi (ixtiyoriy). Mavjud bo‘lsa backend saytni ham beradi.
FRONTEND_DIST=../frontend/dist
